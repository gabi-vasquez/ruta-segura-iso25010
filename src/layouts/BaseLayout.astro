---
// Define los datos que cualquier página puede enviar a esta plantilla.
interface Props {
  title: string;
  description: string;
}

// Lee el título y la descripción enviados por la página principal.
const { title, description } = Astro.props;

// Obtiene la ruta base para que el icono funcione en GitHub Pages.
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<!-- Declara español como idioma para lectores de pantalla y buscadores. -->
<html lang="es">
  <head>
    <!-- Permite mostrar correctamente tildes y caracteres especiales. -->
    <meta charset="UTF-8" />
    <!-- Ajusta la interfaz al ancho de teléfonos, tabletas y computadores. -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Explica el contenido cuando un buscador muestra el resultado. -->
    <meta name="description" content={description} />
    <!-- Define el color del navegador en dispositivos compatibles. -->
    <meta name="theme-color" content="#f4f7fb" />
    <!-- Usa un icono propio relacionado con la ruta segura. -->
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <!-- Muestra un nombre claro en la pestaña del navegador. -->
    <title>{title}</title>
  </head>
  <body>
    <!-- Inserta aquí el contenido específico de cada página. -->
    <slot />
  </body>
</html>
