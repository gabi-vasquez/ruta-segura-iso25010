---
//etiqueta
import BaseLayout from "../layouts/BaseLayout.astro";

import "../styles/global.css";

const title = "Ruta Segura | Demostración ISO/IEC 25010";


const description = "Simulador que previene errores al configurar una entrega con dron.";
---

<!-- Aplica la estructura común y envía sus metadatos. -->
<BaseLayout {title} {description}>
  <main class="page">
    <header class="masthead">
      <div class="brand">
        <!-- Oculta el símbolo a lectores de pantalla porque el texto ya lo explica. -->
        <span class="brand-mark" aria-hidden="true">✓</span>
        <span>Ruta Segura</span>
      </div>
      <p class="standard">ISO/IEC 25010 · Protección contra errores del usuario</p>
    </header>

    <!-- Presenta el objetivo y el criterio que puede comprobarse. -->
    <section class="brief" aria-labelledby="page-title">
      <div>
        <h1 id="page-title">Prepara una entrega que pueda despegar.</h1>
        <p class="brief-copy">Configura el peso, la batería y la zona de vuelo. El sistema bloquea cualquier combinación peligrosa y explica qué debes corregir.</p>
      </div>

      <!-- Muestra el requisito medible junto al contador en tiempo real. -->
      <aside class="requirement" aria-label="Requisito comprobable">
        <h2>Condición de aceptación</h2>
        <p>El despegue solo se activa cuando los tres controles cumplen sus límites.</p>
        <div class="score-row">
          <strong id="score" class="score" aria-live="polite">0/3</strong>
          <span>controles válidos</span>
        </div>
      </aside>
    </section>

    <!-- Une el formulario y la ruta de validación en una sola consola. -->
    <section class="console" aria-label="Consola de autorización de vuelo">
      <div class="controls">
        <div class="console-head">
          <div>
            <h2>Misión DR-042</h2>
            <p class="mission-detail">Medicamentos para el centro de salud Norte</p>
          </div>
          <span id="missionStatus" class="status">Revisión pendiente</span>
        </div>

        <!-- Desactiva la validación nativa para mostrar mensajes propios y específicos. -->
        <form id="missionForm" novalidate>
          <div class="fields">
            <div class="field">
              <label for="weight">Peso del paquete</label>
              <input id="weight" name="weight" type="number" min="0.1" max="5" step="0.1" value="7" aria-describedby="weightHelp weightError" aria-invalid="true" />
              <span id="weightHelp" class="help">Usa un valor entre 0,1 y 5 kg.</span>
              <span id="weightError" class="error" aria-live="polite">Reduce el peso a 5 kg o menos.</span>
            </div>

            <!-- Agrupa etiqueta, control, ayuda y error de la batería. -->
            <div class="field">
              <label for="battery">Batería disponible</label>
              <input id="battery" name="battery" type="number" min="40" max="100" step="1" value="25" aria-describedby="batteryHelp batteryError" aria-invalid="true" />
              <span id="batteryHelp" class="help">Necesitas entre 40 % y 100 %.</span>
              <span id="batteryError" class="error" aria-live="polite">Carga la batería al menos hasta 40 %.</span>
            </div>

            <!-- Hace que la zona ocupe el ancho completo del formulario. -->
            <div class="field field-wide">
              <label for="zone">Zona de entrega</label>
              <select id="zone" name="zone" aria-describedby="zoneHelp zoneError" aria-invalid="true">
                <option value="restricted" selected>R-12 · Zona restringida</option>
                <option value="north">N-04 · Centro Norte</option>
                <option value="east">E-08 · Corredor Este</option>
              </select>
              <span id="zoneHelp" class="help">Las zonas restringidas no admiten vuelos.</span>
              <span id="zoneError" class="error" aria-live="polite">Selecciona una zona autorizada.</span>
            </div>
          </div>

          <!-- Coloca la acción final junto a un atajo para la demostración. -->
          <div class="actions">
            <button id="submitButton" class="button button-primary" type="submit" disabled>Autorizar despegue</button>
            <button id="fixButton" class="button button-secondary" type="button">Aplicar valores seguros</button>
          </div>
        </form>
      </div>

      <!-- Representa los controles como paradas de una ruta de vuelo. -->
      <aside class="route" aria-labelledby="route-title">
        <h2 id="route-title">Ruta de validación</h2>
        <div class="checklist" aria-live="polite">
          <div id="weightCheck" class="check">
            <span class="check-icon" aria-hidden="true">×</span>
            <div><strong>Carga admitida</strong><span>Máximo 5 kg</span></div>
          </div>
          <div id="batteryCheck" class="check">
            <span class="check-icon" aria-hidden="true">×</span>
            <div><strong>Autonomía suficiente</strong><span>Mínimo 40 %</span></div>
          </div>
          <div id="zoneCheck" class="check">
            <span class="check-icon" aria-hidden="true">×</span>
            <div><strong>Zona autorizada</strong><span>Sin restricción de vuelo</span></div>
          </div>
        </div>
        <div id="result" class="result"><strong>Acción bloqueada.</strong><br />Corrige los campos señalados.</div>
      </aside>
    </section>

    <!-- Documenta la relación entre el ejercicio y la norma. -->
    <section class="explanation" aria-labelledby="explanation-title">
      <h2 id="explanation-title">Qué demuestra</h2>
      <div class="notes">
        <article class="note"><h3>La idea</h3><p>Una persona configura una entrega con dron y recibe ayuda antes de autorizarla.</p></article>
        <article class="note"><h3>La característica</h3><p>Protección contra errores del usuario, dentro de la capacidad de interacción de ISO/IEC 25010.</p></article>
        <article class="note"><h3>La prueba</h3><p>El botón permanece bloqueado hasta que peso, batería y zona cumplen sus límites.</p></article>
      </div>
    </section>

    <!-- Aclara el alcance académico del ejercicio. -->
    <p class="footer">Demostración educativa. El proyecto no constituye una certificación formal.</p>
  </main>

  <div id="toast" class="toast" role="status" aria-live="polite">Misión autorizada. Los tres controles son válidos.</div>

  <script>
    // Importa la clase que coordina toda la aplicación orientada a objetos.
    import { MissionApplication } from "../scripts/MissionApplication";

    // Crea una instancia y conecta sus objetos con la interfaz renderizada por Astro.
    new MissionApplication(document).start();
  </script>
</BaseLayout>
